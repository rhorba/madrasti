# ---------------------------------------------------------------------------
# Madrasti - environment template. Copy to .env and fill in.
# NEVER commit .env. CTS rule 10: every var the project needs is listed here.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Local dev is served by docker-compose.yml.
DATABASE_URL="postgresql://madrasti:madrasti_dev@localhost:5432/madrasti"

# --- Auth.js v5 (required) -------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Auth.js is forced to secure cookies in production to avoid the Edge/Node
# cookie-name split behind a TLS-terminating proxy (CLAUDE.md 16.1).
AUTH_TRUST_HOST="true"

# --- Cloudflare R2 (optional in dev) ---------------------------------------
# Student photos and homework attachments. PRIVATE bucket, presigned URLs only
# - these are records about minors and must never be publicly readable.
# Leave blank in dev: uploads are disabled and the UI hides the controls.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="madrasti-private"

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Build -----------------------------------------------------------------
# Standalone output needs symlinks; fails on Windows without Developer Mode.
# Set to 1 only in Docker/CI builds (CLAUDE.md 16.5).
BUILD_STANDALONE=""
